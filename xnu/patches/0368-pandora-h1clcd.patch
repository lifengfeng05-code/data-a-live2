+ * subclass is what the device tree personality instantiates. */
+class AppleH1CLCD : public AppleCLCD
+{
+	OSDeclareDefaultStructors(AppleH1CLCD);
+};
+
+OSDefineMetaClassAndStructors(AppleH1CLCD, AppleCLCD);
 
