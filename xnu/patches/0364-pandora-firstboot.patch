diff --git a/iokit/Kernel/arm/SweetFirstBoot.cpp b/iokit/Kernel/arm/SweetFirstBoot.cpp
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/SweetFirstBoot.cpp
@@ -0,0 +1,258 @@
+/*
+ * PANDORA first-boot state (patch 0364).
+ *
+ * A stock iOS root volume plus an empty Data volume brings launchd and the daemons up, but
+ * SpringBoard then stays in the Setup Assistant: nothing ever created the container
+ * directories and nothing ever wrote the first-boot preferences. Both live on the Data volume,
+ * which shows up at /private/var during mount-phase-2, so this thread waits for
+ * /private/var/mobile and only then creates and writes:
+ *
+ *   /private/var/containers/{Bundle,Data/System,Shared/SystemGroup,Temp}
+ *   /private/var/mobile/Library/Preferences/com.apple.purplebuddy.plist
+ *   /private/var/mobile/Library/Preferences/com.apple.purplebuddy.notbackedup.plist
+ *   /private/var/mobile/Library/Preferences/com.apple.managedconfiguration.notbackedup.plist
+ *   /private/var/mobile/Library/Preferences/com.apple.springboard.plist
+ *   /private/var/mobile/Library/Preferences/com.apple.migration.plist
+ *
+ * The values follow the UniXNU skip-setup tool for 21H461 / 17.7.11. Boot-arg
+ * pandora_skipsetup=0 turns the thread off.
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <sys/fcntl.h>
+#include <sys/uio.h>
+#include <sys/vnode.h>
+#include <sys/vnode_internal.h>
+#include <sys/kauth.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <pexpert/pexpert.h>
+
+extern "C" int pandora_mkdir(const char *path, int mode);
+extern "C" int vnode_open(const char *path, int fmode, int cmode, int flag, vnode_t *vpp,
+    vfs_context_t ctxt);
+extern "C" int vnode_close(vnode_t vp, int flags, vfs_context_t ctxt);
+extern "C" int vn_rdwr(enum uio_rw rw, struct vnode *vp, caddr_t base, int len, off_t offset,
+    enum uio_seg segflg, int ioflg, kauth_cred_t cred, int *aresid, proc_t p);
+
+#define SWEET_FB_BUILD    "21H461"
+#define SWEET_FB_POLL_MS  250
+#define SWEET_FB_POLL_MAX 1200          /* 5 minutes */
+
+static const char *sweet_fb_dirs[] = {
+	"/private/var/containers",
+	"/private/var/containers/Bundle",
+	"/private/var/containers/Data",
+	"/private/var/containers/Data/System",
+	"/private/var/containers/Shared",
+	"/private/var/containers/Shared/SystemGroup",
+	"/private/var/containers/Temp",
+	"/private/var/mobile/Library",
+	"/private/var/mobile/Library/Preferences",
+};
+
+static const char sweet_fb_purplebuddy[] =
+	"<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
+	"<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" "
+	"\"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n"
+	"<plist version=\"1.0\">\n"
+	"<dict>\n"
+	"\t<key>SetupDone</key><true/>\n"
+	"\t<key>SetupFinishedAllSteps</key><true/>\n"
+	"\t<key>SetupVersion</key><integer>11</integer>\n"
+	"\t<key>daemonizeNeedsToRun</key><false/>\n"
+	"</dict>\n"
+	"</plist>\n";
+
+static const char sweet_fb_purplebuddy_nb[] =
+	"<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
+	"<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" "
+	"\"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n"
+	"<plist version=\"1.0\">\n"
+	"<dict>\n"
+	"\t<key>MiniBuddyDiagnostics</key><false/>\n"
+	"\t<key>MiniBuddyHSA2</key><false/>\n"
+	"\t<key>MiniBuddyKeychainSync</key><false/>\n"
+	"\t<key>MiniBuddyMesa</key><false/>\n"
+	"\t<key>MiniBuddyPayment</key><false/>\n"
+	"\t<key>MiniBuddyStandard</key><false/>\n"
+	"\t<key>MiniBuddySilentICDP</key><false/>\n"
+	"</dict>\n"
+	"</plist>\n";
+
+static const char sweet_fb_mc_nb[] =
+	"<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
+	"<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" "
+	"\"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n"
+	"<plist version=\"1.0\">\n"
+	"<dict>\n"
+	"\t<key>LockdownActivationIndicatesCloudConfigurationAvailable</key><false/>\n"
+	"</dict>\n"
+	"</plist>\n";
+
+static const char sweet_fb_springboard[] =
+	"<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
+	"<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" "
+	"\"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n"
+	"<plist version=\"1.0\">\n"
+	"<dict>\n"
+	"\t<key>BKNoWatchdogs</key><true/>\n"
+	"\t<key>FBLaunchWatchdogExceptions</key>\n"
+	"\t<dict><key>com.apple.purplebuddy</key><integer>100</integer></dict>\n"
+	"\t<key>MCForceShowCloudConfigurationUI</key><false/>\n"
+	"\t<key>SBDisableAutoDim</key><true/>\n"
+	"\t<key>SBDontDimOrLockOnAC</key><true/>\n"
+	"\t<key>SBDisableIdleSleep</key><true/>\n"
+	"</dict>\n"
+	"</plist>\n";
+
+static const char sweet_fb_migration[] =
+	"<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
+	"<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" "
+	"\"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n"
+	"<plist version=\"1.0\">\n"
+	"<dict>\n"
+	"\t<key>LastSystemVersion</key><string>" SWEET_FB_BUILD "</string>\n"
+	"\t<key>DMUserDataDisposition</key>\n"
+	"\t<dict>\n"
+	"\t\t<key>SyntheticDidUpgrade</key><false/>\n"
+	"\t\t<key>buildVersion</key><string>" SWEET_FB_BUILD "</string>\n"
+	"\t</dict>\n"
+	"</dict>\n"
+	"</plist>\n";
+
+struct sweet_fb_file {
+	const char *path;
+	const char *data;
+};
+
+static const struct sweet_fb_file sweet_fb_files[] = {
+	{ "/private/var/mobile/Library/Preferences/com.apple.purplebuddy.plist",
+	  sweet_fb_purplebuddy },
+	{ "/private/var/mobile/Library/Preferences/com.apple.purplebuddy.notbackedup.plist",
+	  sweet_fb_purplebuddy_nb },
+	{ "/private/var/mobile/Library/Preferences/com.apple.managedconfiguration.notbackedup.plist",
+	  sweet_fb_mc_nb },
+	{ "/private/var/mobile/Library/Preferences/com.apple.springboard.plist",
+	  sweet_fb_springboard },
+	{ "/private/var/mobile/Library/Preferences/com.apple.migration.plist",
+	  sweet_fb_migration },
+};
+
+static void
+sweet_fb_sleep(unsigned ms)
+{
+	uint64_t deadline;
+
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&sweet_fb_dirs[0], THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static int
+sweet_fb_exists(const char *path, vfs_context_t ctx)
+{
+	vnode_t vp = NULLVP;
+	int error = vnode_open(path, FREAD, 0, 0, &vp, ctx);
+
+	if (error == 0) {
+		vnode_close(vp, FREAD, ctx);
+	}
+	return error;
+}
+
+static int
+sweet_fb_write(const char *path, const char *data, size_t size, vfs_context_t ctx)
+{
+	vnode_t vp = NULLVP;
+	int error, resid = 0;
+
+	error = vnode_open(path, FWRITE | O_CREAT | O_TRUNC, 0644, 0, &vp, ctx);
+	if (error) {
+		return error;
+	}
+	error = vn_rdwr(UIO_WRITE, vp, (caddr_t)(uintptr_t)data, (int)size, 0, UIO_SYSSPACE,
+	    IO_NOCACHE | IO_NODELOCKED | IO_UNIT, vfs_context_ucred(ctx), &resid,
+	    vfs_context_proc(ctx));
+	if (error == 0 && resid != 0) {
+		error = EIO;
+	}
+	vnode_close(vp, FWRITE, ctx);
+	return error;
+}
+
+static void
+sweet_fb_thread(void *arg, wait_result_t result)
+{
+	vfs_context_t ctx;
+	int i, dirs = 0, files = 0, failed = 0, ready = 0, value = 0;
+
+	(void)arg;
+	(void)result;
+
+	if (PE_parse_boot_argn("pandora_skipsetup", &value, sizeof(value)) && value == 0) {
+		printf("PANDORA SKIP: disabled by boot-arg\n");
+		thread_terminate(current_thread());
+	}
+
+	ctx = vfs_context_create(NULL);
+	if (ctx == NULL) {
+		printf("PANDORA SKIP: no vfs context\n");
+		thread_terminate(current_thread());
+	}
+
+	for (i = 0; i < SWEET_FB_POLL_MAX; i++) {
+		if (sweet_fb_exists("/private/var/mobile", ctx) == 0) {
+			ready = 1;
+			break;
+		}
+		sweet_fb_sleep(SWEET_FB_POLL_MS);
+	}
+	if (!ready) {
+		printf("PANDORA SKIP: /private/var/mobile never appeared\n");
+		goto out;
+	}
+	printf("PANDORA SKIP: Data volume is up, writing first-boot state\n");
+
+	for (i = 0; i < (int)(sizeof(sweet_fb_dirs) / sizeof(sweet_fb_dirs[0])); i++) {
+		int error = pandora_mkdir(sweet_fb_dirs[i], 0755);
+
+		if (error == 0 || error == EEXIST) {
+			dirs++;
+		} else {
+			failed++;
+			printf("PANDORA SKIP: mkdir %s: error %d\n", sweet_fb_dirs[i], error);
+		}
+	}
+
+	for (i = 0; i < (int)(sizeof(sweet_fb_files) / sizeof(sweet_fb_files[0])); i++) {
+		const struct sweet_fb_file *f = &sweet_fb_files[i];
+		int error = sweet_fb_write(f->path, f->data, strlen(f->data), ctx);
+
+		if (error) {
+			failed++;
+			printf("PANDORA SKIP: %s: error %d\n", f->path, error);
+		} else {
+			files++;
+		}
+	}
+
+	printf("PANDORA SKIP: done, %d dirs, %d files, %d failed\n", dirs, files, failed);
+out:
+	vfs_context_rele(ctx);
+	thread_terminate(current_thread());
+}
+
+void
+sweet_firstboot_start(void)
+{
+	thread_t t;
+
+	if (kernel_thread_start(sweet_fb_thread, NULL, &t) != KERN_SUCCESS) {
+		printf("PANDORA SKIP: no thread\n");
+		return;
+	}
+	thread_deallocate(t);
+}
