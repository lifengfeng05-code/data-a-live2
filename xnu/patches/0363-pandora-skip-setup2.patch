--- /dev/null
+++ b/bsd/dev/pandora_firstboot.c
@@ -0,0 +1,268 @@
+/*
+ * PANDORA skip-setup (patch 0362).
+ *
+ * A stock iOS root volume plus an empty Data volume brings launchd and the daemons up, but
+ * SpringBoard then sits in the Setup Assistant instead of the Home Screen: nothing ever wrote
+ * the first-boot preferences and nothing ever created the container directories. Both live on
+ * the Data volume, which is mounted at /private/var long after the early file installer runs,
+ * so this thread waits for /private/var/mobile to appear and only then creates and writes:
+ *
+ *   /private/var/containers/{Bundle,Data/System,Shared/SystemGroup,Temp}
+ *   /private/var/mobile/Library/Preferences/com.apple.purplebuddy.plist
+ *   /private/var/mobile/Library/Preferences/com.apple.purplebuddy.notbackedup.plist
+ *   /private/var/mobile/Library/Preferences/com.apple.managedconfiguration.notbackedup.plist
+ *   /private/var/mobile/Library/Preferences/com.apple.springboard.plist
+ *   /private/var/mobile/Library/Preferences/com.apple.migration.plist
+ *
+ * The values are the ones the UniXNU skip-setup tool writes (21H461 / 17.7.11); change
+ * PANDORA_SS_BUILD and PANDORA_SS_VERSION when the root volume is a different build.
+ * Boot-arg pandora_skipsetup=0 turns it off.
+ */
+#if defined(PANDORA)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <sys/fcntl.h>
+#include <sys/vnode.h>
+#include <sys/vnode_internal.h>
+#include <sys/kauth.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <pexpert/pexpert.h>
+
+extern kern_return_t thread_terminate(thread_t);
+extern int pandora_mkdir(const char *path, int mode);
+
+void pandora_skipsetup_init(void);
+
+#define PANDORA_SS_BUILD    "21H461"
+#define PANDORA_SS_VERSION  "17.7.11"
+
+static const char *pandora_ss_dirs[] = {
+	"/private/var/containers",
+	"/private/var/containers/Bundle",
+	"/private/var/containers/Data",
+	"/private/var/containers/Data/System",
+	"/private/var/containers/Shared",
+	"/private/var/containers/Shared/SystemGroup",
+	"/private/var/containers/Temp",
+	"/private/var/mobile/Library",
+	"/private/var/mobile/Library/Preferences",
+};
+
+static const char pandora_ss_purplebuddy[] =
+	"<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
+	"<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" "
+	"\"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n"
+	"<plist version=\"1.0\">\n"
+	"<dict>\n"
+	"\t<key>SetupDone</key><true/>\n"
+	"\t<key>SetupFinishedAllSteps</key><true/>\n"
+	"\t<key>SetupVersion</key><integer>11</integer>\n"
+	"\t<key>daemonizeNeedsToRun</key><false/>\n"
+	"</dict>\n"
+	"</plist>\n";
+
+static const char pandora_ss_purplebuddy_nb[] =
+	"<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
+	"<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" "
+	"\"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n"
+	"<plist version=\"1.0\">\n"
+	"<dict>\n"
+	"\t<key>MiniBuddyDiagnostics</key><false/>\n"
+	"\t<key>MiniBuddyHSA2</key><false/>\n"
+	"\t<key>MiniBuddyKeychainSync</key><false/>\n"
+	"\t<key>MiniBuddyMesa</key><false/>\n"
+	"\t<key>MiniBuddyPayment</key><false/>\n"
+	"\t<key>MiniBuddyStandard</key><false/>\n"
+	"\t<key>MiniBuddySilentICDP</key><false/>\n"
+	"</dict>\n"
+	"</plist>\n";
+
+static const char pandora_ss_mc_nb[] =
+	"<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
+	"<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" "
+	"\"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n"
+	"<plist version=\"1.0\">\n"
+	"<dict>\n"
+	"\t<key>LockdownActivationIndicatesCloudConfigurationAvailable</key><false/>\n"
+	"</dict>\n"
+	"</plist>\n";
+
+static const char pandora_ss_springboard[] =
+	"<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
+	"<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" "
+	"\"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n"
+	"<plist version=\"1.0\">\n"
+	"<dict>\n"
+	"\t<key>BKNoWatchdogs</key><true/>\n"
+	"\t<key>FBLaunchWatchdogExceptions</key>\n"
+	"\t<dict><key>com.apple.purplebuddy</key><integer>100</integer></dict>\n"
+	"\t<key>MCForceShowCloudConfigurationUI</key><false/>\n"
+	"\t<key>SBDisableAutoDim</key><true/>\n"
+	"\t<key>SBDontDimOrLockOnAC</key><true/>\n"
+	"\t<key>SBDisableIdleSleep</key><true/>\n"
+	"</dict>\n"
+	"</plist>\n";
+
+static const char pandora_ss_migration[] =
+	"<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
+	"<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" "
+	"\"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n"
+	"<plist version=\"1.0\">\n"
+	"<dict>\n"
+	"\t<key>LastSystemVersion</key><string>" PANDORA_SS_BUILD "</string>\n"
+	"\t<key>DMUserDataDisposition</key>\n"
+	"\t<dict>\n"
+	"\t\t<key>SyntheticDidUpgrade</key><false/>\n"
+	"\t\t<key>buildVersion</key><string>" PANDORA_SS_BUILD "</string>\n"
+	"\t</dict>\n"
+	"</dict>\n"
+	"</plist>\n";
+
+struct pandora_ss_file {
+	const char *path;
+	const char *data;
+};
+
+static const struct pandora_ss_file pandora_ss_files[] = {
+	{ "/private/var/mobile/Library/Preferences/com.apple.purplebuddy.plist",
+	  pandora_ss_purplebuddy },
+	{ "/private/var/mobile/Library/Preferences/com.apple.purplebuddy.notbackedup.plist",
+	  pandora_ss_purplebuddy_nb },
+	{ "/private/var/mobile/Library/Preferences/com.apple.managedconfiguration.notbackedup.plist",
+	  pandora_ss_mc_nb },
+	{ "/private/var/mobile/Library/Preferences/com.apple.springboard.plist",
+	  pandora_ss_springboard },
+	{ "/private/var/mobile/Library/Preferences/com.apple.migration.plist",
+	  pandora_ss_migration },
+};
+
+#define PANDORA_SS_POLL_MS   250
+#define PANDORA_SS_POLL_MAX  1200      /* 1200 * 250 ms = 5 minutes */
+
+static void
+ps_sleep(unsigned ms)
+{
+	uint64_t deadline;
+
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&pandora_ss_files[0], THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static int
+ps_exists(const char *path, vfs_context_t ctx)
+{
+	vnode_t vp = NULLVP;
+	int error = vnode_open(path, FREAD, 0, 0, &vp, ctx);
+
+	if (error == 0) {
+		vnode_close(vp, FREAD, ctx);
+	}
+	return error;
+}
+
+static int
+ps_write(const char *path, const char *data, size_t size, vfs_context_t ctx)
+{
+	vnode_t vp = NULLVP;
+	int error;
+	size_t done = 0;
+
+	error = vnode_open(path, FWRITE | O_CREAT | O_TRUNC, 0644, 0, &vp, ctx);
+	if (error) {
+		return error;
+	}
+	while (done < size) {
+		size_t chunk = size - done;
+		error = vn_rdwr(UIO_WRITE, vp, CAST_DADDR(data + done), (int)chunk, (off_t)done,
+		    UIO_SYSSPACE32, IO_NOCACHE | IO_NODELOCKED | IO_UNIT, vfs_context_ucred(ctx),
+		    NULL, vfs_context_proc(ctx));
+		if (error) {
+			break;
+		}
+		done += chunk;
+	}
+	vnode_close(vp, FWRITE, ctx);
+	return error;
+}
+
+static void
+ps_thread(void *arg, wait_result_t result)
+{
+	vfs_context_t ctx;
+	int i, written = 0, kept = 0, failed = 0, ready = 0;
+	int value = 0;
+
+	(void)arg;
+	(void)result;
+
+	if (PE_parse_boot_argn("pandora_skipsetup", &value, sizeof(value)) && value == 0) {
+		printf("PANDORA SKIP: disabled by boot-arg\n");
+		thread_terminate(current_thread());
+	}
+
+	ctx = vfs_context_create(NULL);
+	if (ctx == NULL) {
+		printf("PANDORA SKIP: no vfs context\n");
+		thread_terminate(current_thread());
+	}
+
+	/* The Data volume is mounted at /private/var during mount-phase-2, well after start. */
+	for (i = 0; i < PANDORA_SS_POLL_MAX; i++) {
+		if (ps_exists("/private/var/mobile", ctx) == 0) {
+			ready = 1;
+			break;
+		}
+		ps_sleep(PANDORA_SS_POLL_MS);
+	}
+	if (!ready) {
+		printf("PANDORA SKIP: /private/var/mobile never appeared\n");
+		goto out;
+	}
+	printf("PANDORA SKIP: Data volume is up, writing first-boot state\n");
+
+	for (i = 0; i < (int)(sizeof(pandora_ss_dirs) / sizeof(pandora_ss_dirs[0])); i++) {
+		int error = pandora_mkdir(pandora_ss_dirs[i], 0755);
+
+		if (error == 0 || error == EEXIST) {
+			written++;
+		} else {
+			failed++;
+			printf("PANDORA SKIP: mkdir %s: error %d\n", pandora_ss_dirs[i], error);
+		}
+	}
+
+	for (i = 0; i < (int)(sizeof(pandora_ss_files) / sizeof(pandora_ss_files[0])); i++) {
+		const struct pandora_ss_file *f = &pandora_ss_files[i];
+		size_t size = strlen(f->data);
+		int error = ps_write(f->path, f->data, size, ctx);
+
+		if (error) {
+			failed++;
+			printf("PANDORA SKIP: %s: error %d\n", f->path, error);
+		} else {
+			kept++;
+		}
+	}
+
+	printf("PANDORA SKIP: done, %d dirs, %d files, %d failed\n", written, kept, failed);
+out:
+	vfs_context_rele(ctx);
+	thread_terminate(current_thread());
+}
+
+void
+pandora_skipsetup_init(void)
+{
+	thread_t t;
+
+	if (kernel_thread_start(ps_thread, NULL, &t) != KERN_SUCCESS) {
+		printf("PANDORA SKIP: no thread\n");
+		return;
+	}
+	thread_deallocate(t);
+}
+#endif /* PANDORA */
