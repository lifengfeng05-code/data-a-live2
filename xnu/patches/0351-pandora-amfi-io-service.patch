diff --git a/iokit/Kernel/IOUserClient.cpp b/iokit/Kernel/IOUserClient.cpp
--- a/iokit/Kernel/IOUserClient.cpp
+++ b/iokit/Kernel/IOUserClient.cpp
@@ -6714,4 +6714,107 @@
 OSMetaClassDefineReservedUnused(IOUserClient2022, 0);
 OSMetaClassDefineReservedUnused(IOUserClient2022, 1);
 OSMetaClassDefineReservedUnused(IOUserClient2022, 2);
 OSMetaClassDefineReservedUnused(IOUserClient2022, 3);
+/* PANDORA: a minimal AppleMobileFileIntegrity IOKit service.
+ *
+ * The built-in sweet AMFI only implements the MACF callbacks, so launchd_cache_loader (and
+ * later amfid) cannot find the AMFI user client and abort with "Unable to find AMFI"; launchd
+ * then exits with "No service cache". The class is deliberately named after Apple's service,
+ * because IOKit matching goes by class name. Every request is accepted: the caller only needs
+ * its verification to succeed so that it goes on and writes its own cache. */
+
+class AppleMobileFileIntegrityUserClient;
+
+class AppleMobileFileIntegrity : public IOService
+{
+	OSDeclareDefaultStructors(AppleMobileFileIntegrity);
+
+public:
+	virtual bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn newUserClient(task_t owningTask, void *securityID, UInt32 type,
+	    OSDictionary *properties, IOUserClient **handler) APPLE_KEXT_OVERRIDE;
+};
+
+class AppleMobileFileIntegrityUserClient : public IOUserClient
+{
+	OSDeclareDefaultStructors(AppleMobileFileIntegrityUserClient);
+
+public:
+	virtual IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+	    IOExternalMethodDispatch *dispatch, OSObject *target, void *reference) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(AppleMobileFileIntegrityUserClient, IOUserClient);
+OSDefineMetaClassAndStructors(AppleMobileFileIntegrity, IOService);
+
+IOReturn
+AppleMobileFileIntegrityUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+    IOExternalMethodDispatch *dispatch, OSObject *target, void *reference)
+{
+	(void)selector;
+	(void)dispatch;
+	(void)target;
+	(void)reference;
+
+	if (args != NULL) {
+		for (uint32_t i = 0; i < args->scalarOutputCount; i++) {
+			args->scalarOutput[i] = 0;
+		}
+	}
+	return kIOReturnSuccess;
+}
+
+bool
+AppleMobileFileIntegrity::start(IOService *provider)
+{
+	if (!super::start(provider)) {
+		return false;
+	}
+	registerService();
+	return true;
+}
+
+IOReturn
+AppleMobileFileIntegrity::newUserClient(task_t owningTask, void *securityID, UInt32 type,
+    OSDictionary *properties, IOUserClient **handler)
+{
+	(void)owningTask;
+	(void)securityID;
+	(void)type;
+	(void)properties;
+
+	AppleMobileFileIntegrityUserClient *client = new AppleMobileFileIntegrityUserClient;
+
+	if (client == NULL) {
+		return kIOReturnNoMemory;
+	}
+	if (!client->init() || !client->attach(this) || !client->start(this)) {
+		client->detach(this);
+		client->release();
+		return kIOReturnError;
+	}
+	*handler = client;
+	return kIOReturnSuccess;
+}
+
+extern "C" void
+sweet_amfi_publish_service(IOService *parent)
+{
+	static bool published = false;
+
+	if (published || parent == NULL) {
+		return;
+	}
+	AppleMobileFileIntegrity *service = new AppleMobileFileIntegrity;
+
+	if (service == NULL) {
+		return;
+	}
+	if (service->init() && service->attach(parent)) {
+		service->registerService();
+		published = true;
+		printf("SWEET AMFI: AppleMobileFileIntegrity service published\n");
+	} else {
+		printf("SWEET AMFI: service attach failed\n");
+	}
+}
