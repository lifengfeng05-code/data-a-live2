diff --git a/iokit/Kernel/IOPlatformExpert.cpp b/iokit/Kernel/IOPlatformExpert.cpp
--- a/iokit/Kernel/IOPlatformExpert.cpp
+++ b/iokit/Kernel/IOPlatformExpert.cpp
@@ -429,3 +429,50 @@
 			}
+	/*
+	 * PATCH 0379: the subcache headers. dyld_shared_cache_arm64 is only the first file; the
+	 * images (IOKit.framework among them) live in dyld_shared_cache_arm64.NN, and each NN
+	 * carries its own mapping table, which is what turns an address into a file offset.
+	 * 64 KiB from each subcache, appended to one file, is enough for those tables.
+	 */
+	{
+		static const char sub_head[] = "/System/Library/Caches/com.apple.dyld/dyld_shared_cache_arm64.%02d";
+		static const char sub_dst[] = "/System/Library/xpc/dyldcache-subs.bin";
+		static char sub_buf[64 * 1024];
+		vnode_t vout = NULLVP;
+		int got_files = 0;
+
+		if (vnode_open(sub_dst, FWRITE | O_CREAT | O_TRUNC, 0644, 0, &vout, ctx) == 0) {
+			off_t wr = 0;
+			for (int n = 1; n <= 31; n++) {
+				char spath[96];
+				vnode_t vin = NULLVP;
+				int got = 0, resid = 0, error;
+
+				snprintf(spath, sizeof(spath), sub_head, n);
+				if (vnode_open(spath, FREAD, 0, 0, &vin, ctx) != 0) {
+					continue;
+				}
+				error = vn_rdwr(UIO_READ, vin, sub_buf, sizeof(sub_buf), 0, UIO_SYSSPACE,
+				    IO_NOCACHE | IO_NODELOCKED | IO_UNIT, vfs_context_ucred(ctx), &got,
+				    vfs_context_proc(ctx));
+				vnode_close(vin, FREAD, ctx);
+				if (error || got <= 0) {
+					continue;
+				}
+				error = vn_rdwr(UIO_WRITE, vout, sub_buf, got, wr, UIO_SYSSPACE,
+				    IO_NOCACHE | IO_NODELOCKED | IO_UNIT, vfs_context_ucred(ctx), &resid,
+				    vfs_context_proc(ctx));
+				if (error) {
+					break;
+				}
+				wr += got;
+				got_files++;
+			}
+			vnode_close(vout, FWRITE, ctx);
+			printf("PANDORA SKIP: subcache heads dumped, %d files, %lld bytes\n",
+			    got_files, (long long)wr);
+		} else {
+			printf("PANDORA SKIP: cannot create %s\n", sub_dst);
+		}
+	}
 			if (buf != NULL) {
 			}
